# Copy this file to .env and set a real password before hosting this site
# anywhere public. Anyone who knows this password can edit the live site
# (add/edit/delete notes, text, images) via yoursite.com/?edit.
EDIT_PASSWORD=change-me-please

# Port the Express API server listens on (the Vite dev server proxies /api
# and /uploads to this port in development; in production this is the only
# server and also serves the built site).
API_PORT=8787
